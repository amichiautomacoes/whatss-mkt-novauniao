# Modelo para a aba Environment dos dois servicos no EasyPanel.
# Preencha os valores vazios com as credenciais do ambiente remoto.
# Nao use localhost para acessar outro container.
APP_ENV=production
APP_PUBLIC_URL=
PORT=8080
LOG_LEVEL=INFO

SUPABASE_DATABASE_URL=
SUPABASE_SCHEMA=mkt_novauniao

REDIS_URL=
REDIS_QUEUE_PREFIX=whatsapp_mkt
REDIS_VISIBILITY_TIMEOUT_SECONDS=300
REDIS_RETRY_DELAY_SECONDS=300
REDIS_MAX_ATTEMPTS=3

EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
DISPATCH_WEBHOOK_TOKEN=

WHATSAPP_CAMPAIGN_NAME=Natal 2026
WHATSAPP_OPENED_FROM=2026-11-17
WHATSAPP_SEND_TIME=14:00
CAMPAIGN_TIMEZONE=America/Sao_Paulo
WHATSAPP_SCHEDULE_ENABLED=true
# Na primeira implantacao, apenas consulta; altere para false para operar.
WHATSAPP_SCHEDULE_DRY_RUN=true
WHATSAPP_SCHEDULE_LIMIT=500
WORKER_INTERVAL_SECONDS=60
WORKER_BATCH_SIZE=1
DEFAULT_SEND_DELAY_SECONDS=60
DEFAULT_BATCH_SIZE=20
